# Required. Used to sign the session cookie. Use a long random string.
# The server exits on startup if this is missing.
SESSION_SECRET=replace-with-a-long-random-string

# Browser origin allowed to send credentialed requests.
FRONTEND_URL=http://localhost:3000

# Optional. Required only for the Resilience Advisor.
GEMINI_API_KEY=

# Hosts a measured experiment may probe. Ports 3000 and 3001 are always refused.
METRICMANTIS_PROBE_ALLOWLIST=127.0.0.1,localhost

# Real container faults stay off for `npm start`.
# Local testing uses `npm run dev:chaos`. That command sets both variables for
# that process only. If port 3001 is already this project's API with chaos off,
# that process is replaced. Any other listener is left running. The allowlist
# is the approved sandbox services web-app, api, and db. Do not edit this file
# to turn chaos on.
# METRICMANTIS_CHAOS_ENABLED=true
# METRICMANTIS_CHAOS_ALLOWLIST=web-app,api,db

